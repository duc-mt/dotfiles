#!/usr/bin/env bash

# ======================================================================================
#
#         FILE:  install_pass
#       AUTHOR:  Duc Mai <ducmai.network@gmail.com>
#      COMPANY:  ---
#        USAGE:  ./install_pass
#  DESCRIPTION:  A simple password manager using gpg and ordinary unix directories.
#                Verifies signatures where upstream publishes a documented signing key;
#                see the note near the end of this file for extensions that don't.
#      CREATED:  May 05, 2023
#
# ======================================================================================


set -euo pipefail

PASS_VERIFY_HOME="$(mktemp -d)"
trap 'rm -rf "${PASS_VERIFY_HOME}"' EXIT

# --------------------------------------------------------------------------------------
# Remove old installations (if there is any)
# --------------------------------------------------------------------------------------
sudo apt purge -y pass 2>/dev/null || true
sudo apt autoremove -y 2>/dev/null || true

# --------------------------------------------------------------------------------------
# Clone pass and verify the release tag's signature before installing.
# All password-store releases are tagged and signed by Jason A. Donenfeld with this
# key (per https://www.passwordstore.org/ and the project's own release announcements).
# --------------------------------------------------------------------------------------
PASS_SIGNING_KEY="AB9942E6D4A4CFC3412620A749FC7012A5DE03AE" # gitleaks:allow -- public GPG fingerprint, not a secret
PASS_VERSION="1.7.4"

git clone https://git.zx2c4.com/password-store /tmp/password-store
cd /tmp/password-store

gpg --homedir "${PASS_VERIFY_HOME}" --keyserver hkps://keys.openpgp.org \
  --recv-keys "${PASS_SIGNING_KEY}"
if ! GNUPGHOME="${PASS_VERIFY_HOME}" git tag -v "${PASS_VERSION}" 2>&1 \
    | grep -q "Good signature"; then
  echo "Signature verification FAILED for password-store tag ${PASS_VERSION} -- aborting" >&2
  exit 1
fi
git checkout "${PASS_VERSION}"
sudo make install

# --------------------------------------------------------------------------------------
# Prevent gnupg package to be installed (as a dependency of pass through apt-get) as
# the version installed with pass will replace the current version installed manually
