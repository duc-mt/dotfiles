# if grep --fixed-string --quiet "gnupg" "/etc/apt/preferences" 2>/dev/null ; then
#   :
# else
#   lines=("Package: gnupg" "Pin: release *" "Pin-Priority: -1")
#   for line in "${lines[@]}"; do
#     echo "$line" | sudo tee -a /etc/apt/preferences
#   done
# fi

# --------------------------------------------------------------------------------------
# Installing passmenu
# --------------------------------------------------------------------------------------
wget -O /tmp/passmenu \
  https://git.zx2c4.com/password-store/plain/contrib/dmenu/passmenu
chmod -v 755 /tmp/passmenu
sudo mv -v /tmp/passmenu /usr/local/bin/passmenu

# --------------------------------------------------------------------------------------
# Installing pass-update -- verify the signed release tarball before installing.
# Releases are signed by Alexandre Pujol with this key (per the project's own README:
# https://github.com/roddhjav/pass-update).
# --------------------------------------------------------------------------------------
PASS_UPDATE_SIGNING_KEY="06A26D531D56C42D66805049C5469996F0DF68EC" # gitleaks:allow -- public GPG fingerprint, not a secret
PASS_UPDATE_VERSION="2.2.1"

cd /tmp
wget -O pass-update-"${PASS_UPDATE_VERSION}".tar.gz \
  https://github.com/roddhjav/pass-update/releases/download/v"${PASS_UPDATE_VERSION}"/pass-update-"${PASS_UPDATE_VERSION}".tar.gz
wget -O pass-update-"${PASS_UPDATE_VERSION}".tar.gz.asc \
  https://github.com/roddhjav/pass-update/releases/download/v"${PASS_UPDATE_VERSION}"/pass-update-"${PASS_UPDATE_VERSION}".tar.gz.asc

gpg --homedir "${PASS_VERIFY_HOME}" --keyserver hkps://keys.openpgp.org \
  --recv-keys "${PASS_UPDATE_SIGNING_KEY}"
if ! gpg --homedir "${PASS_VERIFY_HOME}" --verify \
    pass-update-"${PASS_UPDATE_VERSION}".tar.gz.asc \
    pass-update-"${PASS_UPDATE_VERSION}".tar.gz 2>&1 | grep -q "Good signature"; then
  echo "Signature verification FAILED for pass-update -- aborting, nothing installed" >&2
  exit 1
fi

tar --extract --file pass-update-"${PASS_UPDATE_VERSION}".tar.gz
cd pass-update-"${PASS_UPDATE_VERSION}"
sudo make install
sudo cp -v share/bash-completion/completions/pass-update /etc/bash_completion.d/pass-update

# --------------------------------------------------------------------------------------
# Installing pass-tail, pass-export, pass-tessen
#
# NOTE: unlike password-store and pass-update above, these three extensions don't
# publish a documented release-signing key, so there's nothing trustworthy to verify
# against -- these still build whatever's on the default branch tip. If you want the
# same guarantee as the two above, pin each to a specific commit you've reviewed
# yourself (git clone, then `git checkout <commit>` before `make install`).
# --------------------------------------------------------------------------------------
cd /tmp
git clone https://github.com/palortoff/pass-extension-tail.git
cd pass-extension-tail
sudo make install

cd /tmp
git clone https://github.com/dvogt23/pass-export.git
cd pass-export
sudo make install

cd /tmp
git clone https://git.sr.ht/~ayushnix/pass-tessen
cd pass-tessen
sudo make install

# --------------------------------------------------------------------------------------
# Installing pass-age
#
# NOTE: same as pass-tail/pass-export/pass-tessen above -- no documented signing key
# published for this repo, so this fetches raw files from the master branch unverified.
# --------------------------------------------------------------------------------------
wget -O /tmp/age.bash \
  https://raw.githubusercontent.com/tijn/pass-age/master/age.bash
chmod 755 /tmp/age.bash
sudo mv -v /tmp/age.bash /usr/lib/password-store/extensions/age.bash

wget -O /tmp/ages.bash \
  https://raw.githubusercontent.com/tijn/pass-age/master/ages.bash
chmod 755 /tmp/ages.bash
sudo mv -v /tmp/ages.bash /usr/lib/password-store/extensions/ages.bash

# --------------------------------------------------------------------------------------
# Adding pass-age completion
# --------------------------------------------------------------------------------------
cat >/tmp/pass-age <<_ACEOF
# pass-age completion file for bash

PASSWORD_STORE_EXTENSION_COMMANDS+=(age)
PASSWORD_STORE_EXTENSION_COMMANDS+=(ages)

__password_store_extension_complete_age() {
    _pass_complete_entries 1
}

__password_store_extension_complete_ages() {
    _pass_complete_entries 1
}
_ACEOF

sudo mv -v /tmp/pass-age /etc/bash_completion.d/pass-age

# --------------------------------------------------------------------------------------
# Adding pass-otp completion
# --------------------------------------------------------------------------------------
wget -O /tmp/pass-otp \
  https://raw.githubusercontent.com/tadfisher/pass-otp/develop/pass-otp.bash.completion
sudo mv -v /tmp/pass-otp /etc/bash_completion.d/pass-otp
